[Unit]
Description=Solarmaa Energie-Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=solarmaa-dash
Group=solarmaa-dash
WorkingDirectory=/opt/solarmaa-dash/pi
ExecStart=/usr/bin/python3 -m solarmaa_dash run -c /etc/solarmaa-dash/config.toml
Restart=always
RestartSec=5
# Port 80 ohne root-Rechte
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
StateDirectory=solarmaa-dash
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/solarmaa-dash

[Install]
WantedBy=multi-user.target
